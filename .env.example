# Copy this file to .env.local for local development, and add the same
# values in your Vercel project's Settings → Environment Variables for
# production. See the setup notes at the bottom of this file.

# ── Admin dashboard login ──────────────────────────────────────────────
# The password you'll type at /admin/login. Pick anything strong.
ADMIN_PASSWORD=

# A separate random secret used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ── Database (submissions + real analytics) ────────────────────────────
# A Postgres connection string. In Vercel: your project → Storage → Create
# Database → pick a Postgres provider (e.g. Neon) from the Marketplace —
# it will add this automatically once connected to your project.
DATABASE_URL=

# ── Email notifications (Resend) ────────────────────────────────────────
# Create a free account at https://resend.com, verify your domain (or use
# their shared onboarding domain to start), then create an API key.
RESEND_API_KEY=

# Where collaboration-form emails get sent. Defaults to connect@blakash.com
# in code if you leave this blank.
ADMIN_NOTIFICATION_EMAIL=connect@blakash.com
